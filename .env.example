# Supabase — create a project at https://supabase.com, run supabase/schema.sql in the SQL editor,
# then copy the URL and anon key from Project Settings → API.
# Without these, Quest Academy runs in Guest mode and saves progress in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (Project Settings → API → service_role). Needed for account deletion and
# Ask Questy daily limits. Never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube (only needed when running `npm run sync-videos`, never shipped to the browser)
# Create a key: Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=
# Your channel: @handle, channel id (UC…) or channel URL
YOUTUBE_CHANNEL=

# Ask Questy, the AI tutor (server only, never shipped to the browser).
# Create a key at https://console.anthropic.com → API Keys. Without it the tutor shows "not switched on yet".
ANTHROPIC_API_KEY=
# Ask Questy daily limits (need SUPABASE_SERVICE_ROLE_KEY). Defaults shown.
# Questions per day for a signed-in learner, for a guest (per IP), and for the whole site (0 = no cap).
TUTOR_DAILY_LIMIT_USER=60
TUTOR_DAILY_LIMIT_GUEST=15
TUTOR_DAILY_BUDGET=3000

# Public site address, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# School layer (see docs/school-setup.md). Weekly parent reports cron (Vercel sends this as a bearer token).
CRON_SECRET=
# Meta WhatsApp Cloud API for weekly reports. Without these, reports are stored and shown in the app only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=weekly_progress_report
WHATSAPP_TEMPLATE_LANG=en
# Optional email fallback: POST {to, subject, text} to this URL.
REPORT_EMAIL_WEBHOOK_URL=
REPORT_EMAIL_WEBHOOK_SECRET=
# Sign in with Kinetix (see docs/kinetix-sso.md): HS256 secret or a JWKS URL.
KINETIX_JWT_SECRET=
KINETIX_JWKS_URL=
KINETIX_ISSUER=
NEXT_PUBLIC_KINETIX_LOGIN_URL=
