# Supabase — create a project at https://supabase.com, run supabase/schema.sql in the SQL editor,
# then copy the URL and anon key from Project Settings → API.
# Without these, Quest Academy runs in Guest mode and saves progress in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouTube (only needed when running `npm run sync-videos`, never shipped to the browser)
# Create a key: Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=
# Your channel: @handle, channel id (UC…) or channel URL
YOUTUBE_CHANNEL=
